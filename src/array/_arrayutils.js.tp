//##import arrCurry from './arrCurry';

/**
 * Counts the number of elements in an array that satisfy a given test function.
 * The function is curried, allowing flexible invocation patterns.
 *
 * @param {Function} testFn - A predicate function that takes an element of the array and returns `true` if the element satisfies the condition, otherwise `false`.
 * @param {Array} arr - The array of elements to be tested. Can also be supplied via currying.
 * 
 * @returns {number} - The count of elements that satisfy the test function.
 *
 * @throws {TypeError} - Throws an error if `testFn` is not a function or `arr` is not an array.
 *
 * @example
 * // Direct invocation
 * const result = arrCount(x => x > 2, [1, 3, 5, 2]);
 * console.log(result); // 2 (elements 3 and 5 satisfy the condition)
 *
 * // Curried invocation
 * const countGreaterThanTwo = arrCount(x => x > 2);
 * console.log(countGreaterThanTwo([1, 3, 5, 2])); // 2
 *
 * @example
 * const result = arrCount(x => typeof x === 'string', [1, 'hello', 3, 'world']);
 * console.log(result); // 2
 * The above looks even better as: arrCount(isString, [1, 'hello', 3, 'world']) // 2
 */
export default const arrCount = arrCurry(
	function(testFn,arr) {
		let len = arr.length;
		let count = 0;
		for(let i=0; i<len; i++) {
			if(testFn(arr[i])) count++;
		}
		return count;
});
//@@
//##import arrCurry from './arrCurry';

/**
 * Computes the mean (average) value of the results of applying a transformation function to each element of an array.
 * The function is curried, allowing flexible invocation patterns.
 *
 * @param {Function} fn - A transformation function that takes an element of the array and returns a number.
 * @param {Array} arr - The array of elements to be processed. Can also be supplied via currying.
 * 
 * @returns {number} - The mean of the transformed elements. If no valid numbers are found, returns `NaN`.
 *
 * @throws {TypeError} - Throws an error if `fn` is not a function or `arr` is not an array.
 *
 * @example
 * // Direct invocation
 * const result = arrMean(x => x * 2, [1, 2, 3, 4]);
 * console.log(result); // 5 (mean of [2, 4, 6, 8])
 *
 * // Curried invocation
 * const meanDouble = arrMean(x => x * 2);
 * console.log(meanDouble([1, 2, 3, 4])); // 5
 *
 * @example
 * const result = arrMean(x => typeof x === 'number' ? x : 0, [10, 20, 'a', 40]);
 * console.log(result); // 23.333333333333332
 */
export default const arrMean = arrCurry(function(fn,arr) {
	let cnt = 0, result = 0.0, len = arr.length;
	for (let i = 0; i < len; i++) {
		let v = fn(arr[i]);
		if( typeof v === 'number') {
			result += v;
			cnt++;
		}
	}
	return result*1.0/cnt;
});




